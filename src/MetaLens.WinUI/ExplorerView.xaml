<UserControl x:Class="MetaLens.WinUI.ExplorerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:ExifMultimediaMetadataViewer.ViewModels">
<UserControl.Resources>
 <DataTemplate x:Key="Tile" x:DataType="m:BrowserEntry"><Grid Padding="4" RowSpacing="2" ToolTipService.ToolTip="{x:Bind Hint}" RightTapped="ContextItem"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{x:Bind TypeGlyph}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"/><Image Stretch="Uniform" Loaded="TileLoaded" Unloaded="TileUnloaded" DataContextChanged="TileChanged"/><TextBlock Grid.Row="1" Text="{x:Bind Name}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="2" FontSize="11" Text="{x:Bind SizeText}"/></Grid></DataTemplate>
 <DataTemplate x:Key="Compact" x:DataType="m:BrowserEntry"><Grid Padding="3" ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind Hint}" RightTapped="ContextItem">
  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid Height="36"><TextBlock Text="{x:Bind TypeGlyph}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Stretch="Uniform" Loaded="TileLoaded" Unloaded="TileUnloaded" DataContextChanged="TileChanged"/></Grid>
  <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Text="{x:Bind TypeGlyph}"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center"/>
 </Grid></DataTemplate>
 <DataTemplate x:Key="Detail" x:DataType="m:BrowserEntry"><Grid Padding="4" ColumnSpacing="4" ToolTipService.ToolTip="{x:Bind Hint}" RightTapped="ContextItem">
  <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
  <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{x:Bind TypeGlyph}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{x:Bind SizeText}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" TextWrapping="Wrap"/><TextBlock Grid.Column="4" Text="{x:Bind PreviewStatus, Mode=OneWay}" TextWrapping="Wrap"/>
 </Grid></DataTemplate>
</UserControl.Resources>
<Grid Padding="4" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <Grid ColumnSpacing="3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="☰" ToolTipService.ToolTip="目录导航、视图和排序"><Button.Flyout><MenuFlyout x:Name="NavMenu"/></Button.Flyout></Button><TextBox x:Name="Address" Grid.Column="1" PlaceholderText="输入路径并回车" KeyDown="AddressKey"/></Grid>
 <TextBox x:Name="Filter" Grid.Row="1" PlaceholderText="搜索当前目录" TextChanged="FilterChanged"/>
 <Grid x:Name="Panels" Grid.Row="2"><TreeView x:Name="Tree" Expanding="ExpandTree" ItemInvoked="TreeInvoked"/><Border x:Name="TreeGrip" Background="{ThemeResource ControlStrongFillColorDefaultBrush}"/><Grid x:Name="Files"><GridView x:Name="Tiles" IsItemClickEnabled="True" ItemClick="ItemClicked" SizeChanged="TileSizeChanged" ItemTemplate="{StaticResource Tile}" SelectionMode="Single"><GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel><GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/></Style></GridView.ItemContainerStyle></GridView><ListView x:Name="Rows" Visibility="Collapsed" IsItemClickEnabled="True" ItemClick="ItemClicked" SelectionMode="Single"/></Grid></Grid></Grid></UserControl>
