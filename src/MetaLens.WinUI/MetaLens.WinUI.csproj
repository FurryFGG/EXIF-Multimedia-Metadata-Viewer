<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework><TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Version>2.0.0</Version><AssemblyVersion>$(Version).0</AssemblyVersion><FileVersion>$(Version).0</FileVersion><InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyName>EXIF全媒体元数据查看器_v$(Version)</AssemblyName><RootNamespace>MetaLens.WinUI</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><PublishSingleFile>false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ApplicationManifest>app.manifest</ApplicationManifest><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" PrivateAssets="all" />
    <ProjectReference Include="../ExifMetadata.Core/ExifMetadata.Core.csproj" />
  </ItemGroup>
  <Target Name="PublishXamlAssets" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="Build">
    <ItemGroup><_XamlAsset Include="$(TargetDir)resources.pri;$(TargetDir)**\*.xbf"/><ResolvedFileToPublish Include="@(_XamlAsset)"><RelativePath>%(_XamlAsset.RecursiveDir)%(_XamlAsset.Filename)%(_XamlAsset.Extension)</RelativePath><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></ResolvedFileToPublish></ItemGroup>
  </Target>
</Project>
