<UserControl x:Class="MetaLens.WinUI.PreviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="4" RowSpacing="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Tools" Orientation="Horizontal" Spacing="3"/></ScrollViewer>
<Grid Grid.Row="1" Background="#FF202124" x:Name="Stage" SizeChanged="StageSize"><ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled" ZoomMode="Disabled"><Canvas x:Name="Surface" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"><Image x:Name="Photo" Stretch="Fill"/></Canvas></ScrollViewer><MediaPlayerElement x:Name="Video" AreTransportControlsEnabled="True" Visibility="Collapsed" AutoPlay="False"/></Grid><TextBlock x:Name="Caption" Text="打开照片、RAW 或视频以查看" Grid.Row="2" FontSize="12" TextTrimming="CharacterEllipsis"/></Grid></UserControl>
