<UserControl x:Class="MetaLens.WinUI.MetadataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:f="using:ExifMetadata.Core.Models" xmlns:local="using:MetaLens.WinUI">
<Grid Padding="5" RowSpacing="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ComboBox x:Name="Tabs" SelectedIndex="0" SelectionChanged="TabChange" HorizontalAlignment="Stretch"><x:String>基本信息</x:String><x:String>全部元数据</x:String><x:String>原始数据 / 诊断</x:String></ComboBox>
 <ListView Grid.Row="1" x:Name="Summary" SelectionMode="Single">
  <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
  <ListView.ItemTemplate><DataTemplate x:DataType="local:SummaryRow"><Grid Padding="6,4" ColumnSpacing="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ToolTipService.ToolTip="{x:Bind Source}"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" FontSize="{x:Bind LabelSize}" Grid.ColumnSpan="{x:Bind Span}" Text="{x:Bind Label}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate>
 </ListView>
 <Grid Grid.Row="1" x:Name="FieldPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBox x:Name="Search" PlaceholderText="搜索来源、标签、路径、ID 或值" TextChanged="SearchChanged"/><ListView x:Name="Fields" Grid.Row="1"><ListView.ItemTemplate><DataTemplate x:DataType="f:MetadataField"><StackPanel Padding="2,3"><TextBlock FontWeight="SemiBold" Text="{x:Bind TagName}"/><TextBlock FontSize="12" Text="{x:Bind FullPath}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind FormattedValue}" MaxLines="3" TextWrapping="Wrap"/><TextBlock Text="{x:Bind RawValue}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind Source}"/><TextBlock Text="{x:Bind TagId}"/><TextBlock Text="{x:Bind DataType}"/></StackPanel></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid>
 <Grid Grid.Row="1" x:Name="RawPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="3"><Button Content="上一页" Click="PrevRaw"/><Button Content="下一页" Click="NextRaw"/><TextBlock x:Name="PageNo" VerticalAlignment="Center"/></StackPanel><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"><TextBlock x:Name="RawText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"/></ScrollViewer></Grid></Grid></UserControl>
