<Window x:Class="ExifMultimediaMetadataViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXIF 全媒体元数据查看器"
        Width="1480" Height="920" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">
    <Grid x:Name="RootGrid" Margin="14">
        <Grid x:Name="MainLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource HighlightBrush}">
                            <TextBlock Text="EX" Foreground="#17243A" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="EXIF 全媒体元数据查看器" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="本地只读 · 不上传媒体文件" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="打开文件" Click="OpenFile_Click" />
                        <Button Content="打开文件夹" Click="OpenFolder_Click" />
                        <Button Content="{Binding BrowserButtonText}" Click="ToggleBrowser_Click" />
                        <Button Content="最近" Click="Recent_Click" />
                        <Button Content="复制字段" Click="CopySelected_Click" />
                        <Button Content="复制全部" Click="CopyAll_Click" />
                        <Button Content="导出 JSON" Click="ExportJson_Click" />
                        <Button Content="导出 CSV" Click="ExportCsv_Click" />
                        <Button Content="{Binding ThemeButtonText}" Click="Theme_Click" />
                        <Button Content="取消" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,8,0,0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="上级" Click="ParentFolder_Click" IsEnabled="{Binding CanGoParent}" />
                        <Button Content="刷新" Click="RefreshFolder_Click" />
                    </StackPanel>
                    <TextBox x:Name="BrowserPathBox" Grid.Column="1" Margin="6,0" VerticalContentAlignment="Center"
                             Text="{Binding CurrentDirectory, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="BrowserPathBox_KeyDown" ToolTip="输入文件夹路径并按 Enter 导航" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BrowserStatus}" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Content="{Binding FileCountText}" IsHitTestVisible="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="FileBrowserPanel" Grid.Row="2" Height="220" Margin="0,8,0,0"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8"
                    Visibility="{Binding IsBrowserExpanded, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="排序" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                            <ComboBox Width="118" Margin="6,0" ItemsSource="{Binding BrowserSortModes}"
                                      SelectedItem="{Binding BrowserSortMode, Mode=TwoWay}" />
                            <Button x:Name="ThumbnailViewButton" Content="缩略图" Click="ThumbnailView_Click" />
                            <Button x:Name="DetailsViewButton" Content="列表" Click="DetailsView_Click" />
                        </StackPanel>
                        <TextBlock Text="当前文件夹" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ThumbnailList" ItemsSource="{Binding BrowserEntries}"
                                 SelectedItem="{Binding SelectedBrowserEntry, Mode=TwoWay}"
                                 SelectionChanged="BrowserList_SelectionChanged" MouseDoubleClick="BrowserList_MouseDoubleClick"
                                 ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 Background="{DynamicResource PanelBrush}" BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="82" Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="104" Height="70" Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                HorizontalAlignment="Left">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="Thumbnail_Loaded" />
                                                <TextBlock Text="{Binding TypeGlyph}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" />
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding PreviewSizeText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeAndDateText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DataGrid x:Name="DetailsList" ItemsSource="{Binding BrowserEntries}"
                                  SelectedItem="{Binding SelectedBrowserEntry, Mode=TwoWay}"
                                  SelectionChanged="BrowserList_SelectionChanged" MouseDoubleClick="BrowserList_MouseDoubleClick"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" Background="{DynamicResource PanelBrush}"
                                  Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                  RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource PanelAltBrush}"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="3*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="*" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="*" />
                                <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" Width="2*" />
                                <DataGridTextColumn Header="预览状态" Binding="{Binding PreviewStatusText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="1.05*" MinWidth="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition x:Name="MetadataColumn" Width="1.1*" MinWidth="390" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,8">
                            <TextBlock Text="媒体预览" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="旋转 90°" Click="Rotate_Click" />
                                <Button Content="适应窗口" Click="FitPreview_Click" />
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{DynamicResource PreviewBrush}" CornerRadius="5" ClipToBounds="True">
                            <Grid>
                                <ContentControl x:Name="NormalViewportHost" />
                                <TextBlock Text="{Binding PreviewMessage}" Foreground="#D6DEE8" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                           Margin="20" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="⛶ 全屏" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="10" Click="ToggleFullScreen_Click" ToolTip="进入全屏查看 (F11)" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0.005" Maximum="8" Value="{Binding Zoom, Mode=TwoWay}"
                                    VerticalAlignment="Center" Margin="4,0,10,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Zoom, StringFormat={}{0:P0}}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" MinWidth="46" />
                        </Grid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                              Cursor="SizeWE" Background="{DynamicResource BorderBrush}"
                              DragCompleted="Splitter_DragCompleted" />

                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="9">
                    <TabControl Background="{DynamicResource PanelBrush}" BorderThickness="0">
                        <TabItem Header="基本信息">
                            <ScrollViewer Margin="5" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SummarySections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Margin="2,6,2,5" />
                                                <ItemsControl ItemsSource="{Binding Fields}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="170" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding LabelZh}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding LabelEn}" FontSize="10"
                                                                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="10,0,2,0"
                                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                                           ToolTip="{Binding SourcePath}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="全部元数据">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="2,2,2,8">
                                    <TextBox Width="280" HorizontalAlignment="Left"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="搜索标签名、标签路径、ID、值或来源" />
                                    <TextBlock Text="{Binding FieldCountText}" DockPanel.Dock="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="12,0" />
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredFields}"
                                          SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True" Background="{DynamicResource PanelBrush}"
                                          Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                          RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource PanelAltBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="75" />
                                        <DataGridTextColumn Header="标签" Binding="{Binding TagName}" Width="150" />
                                        <DataGridTextColumn Header="组 / 完整路径" Binding="{Binding FullPath}" Width="210" />
                                        <DataGridTextColumn Header="ID" Binding="{Binding TagId}" Width="80" />
                                        <DataGridTextColumn Header="格式化值" Binding="{Binding FormattedValue}" Width="2*" />
                                        <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" Width="2*" />
                                        <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="2" Text="双击字段可复制完整路径和值。" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="10" Margin="4,7,4,0" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="原始数据 / 诊断">
                            <Grid Margin="6">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding ParserSummary}" Margin="4,4,4,10" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBox Grid.Row="1" Text="{Binding RawOutput, Mode=OneWay}" IsReadOnly="True"
                                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11" Padding="10"
                                         Background="{DynamicResource PanelAltBrush}" />
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <Border Grid.Row="4" Margin="0,8,0,0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,6">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" Width="110" Height="8" Margin="12,0,2,0"
                                 IsIndeterminate="{Binding IsBusy}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="FullscreenOverlay" Visibility="Collapsed" Background="#080B0F">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="FullscreenViewportHost" />
            <Border Grid.Row="1" Background="#DD151A21" Padding="10,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="上一张" Click="Previous_Click" IsEnabled="{Binding CanGoPrevious}" />
                    <Button Content="适应窗口" Click="FitPreview_Click" />
                    <Button Content="旋转 90°" Click="Rotate_Click" />
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0:P0}}" MinWidth="54" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Foreground="White" Margin="8,0" />
                    <Button Content="下一张" Click="Next_Click" IsEnabled="{Binding CanGoNext}" />
                    <Button Content="退出全屏" Click="ToggleFullScreen_Click" ToolTip="Esc" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
