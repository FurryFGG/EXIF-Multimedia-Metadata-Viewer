<Application x:Class="ExifMultimediaMetadataViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExifMultimediaMetadataViewer"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F6FB" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#EAF0F7" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D4DCE8" />
        <SolidColorBrush x:Key="TextBrush" Color="#17243A" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#65738A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1769D2" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#FFD43B" />
        <SolidColorBrush x:Key="PreviewBrush" Color="#111820" />
        <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

    </Application.Resources>
</Application>
