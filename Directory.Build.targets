<Project>
  <!-- Offline release: omit debugger/data-access APIs for external crash-dump tools.
       Keep the CLR, JIT, XAML, media libraries, licenses and all metadata tag tables. -->
  <Target Name="ExcludeDeveloperPayload" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition=" '%(Filename)%(Extension)' == 'mscordbi.dll' Or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) Or '%(Filename)%(Extension)' == 'createdump.exe' " />
    </ItemGroup>
  </Target>
</Project>
